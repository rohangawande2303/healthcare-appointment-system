# ==============================================================================
# Root .gitignore — Healthcare Appointment System
# ==============================================================================

# Dependencies
node_modules/
*/node_modules/

# Environment files with secrets (keep template examples)
.env
.env.local
.env.development
.env.test
.env.production
*.env.local
!.env.example
!*/.env.example
!*/.env.local.example

# Next.js build output
.next/
frontend/.next/
frontend/out/

# Python virtual environment & runtime binaries
python-runtime/
python-service/python-runtime/
__pycache__/
*/__pycache__/
*.py[cod]
.venv/
*/.venv/

# Logs & temporary files
*.log
npm-debug.log*
yarn-debug.log*
postgres_err.log
postgres_out.log
postgres_ver.log
log.txt

# OS and Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Vercel
.vercel

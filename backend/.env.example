# ==============================================================================
# Backend Environment Configuration Template
# Copy this file to .env and fill in your local or cloud values.
# NEVER commit your actual .env file with secrets to version control.
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=production

# Frontend Client URL (Used for CORS and redirects)
# Local: http://localhost:3000 | Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Connection String
# Local: postgresql://postgres:password@localhost:5432/healthcare_db
# Cloud (Neon / Supabase): postgresql://user:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthcare_db
DB_POOL_MAX=20

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars
JWT_EXPIRE=7d

# Razorpay Test Mode Credentials (https://dashboard.razorpay.com/)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key

# Nodemailer Email Configuration (e.g. Gmail App Password)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# Python Medicine Microservice URL
# Local: http://localhost:8001 | Production: https://your-medicine-service.onrender.com
PYTHON_SERVICE_URL=http://localhost:8001

# WebRTC STUN / TURN Configuration (Optional - Defaults to Google Public STUN)
STUN_SERVER=stun:stun.l.google.com:19302
# TURN_SERVER_URL=turn:your-turn-server.com:3478
# TURN_USERNAME=turn_user
# TURN_CREDENTIAL=turn_password

# Twilio SMS (Optional - Mocked automatically if omitted)
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_token
# TWILIO_PHONE_NUMBER=your_twilio_number
